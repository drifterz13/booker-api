# AI providers
OPENAI_API_KEY=
CHAT_MODEL_NAME=gpt-4o-mini
CHAT_TIMEOUT_SECONDS=120

# Ingestion: process workers per API process
INGESTION_WORKERS=1

# S3-compatible storage (local RustFS defaults)
S3_ACCESS_KEY=rustfs
S3_SECRET_KEY=secret
S3_ENDPOINT_URL=http://localhost:9000

# FastAPI CORS: JSON array
CORS_ALLOWED_ORIGINS=["*"]

# RustFS S3 CORS: comma-separated origins, applied when the container starts
RUSTFS_CORS_ALLOWED_ORIGINS=*

# Integration tests
TEST_DATABASE_URL=postgresql+psycopg://admin:mysecret@localhost:5432/booker-test
TEST_S3_BUCKET_NAME=booker-test
